<?php
/**
 * Resource Page Block: Extended Metadata
 *
 * Fields included:
 * dcterms:creator
 * dcterms:audience
 * dcterms:date
 * dcterms:coverage
 * foaf:based_near
 * dcterms:description
 * dcterms:type
 * dcterms:format
 * dcterms:language
 * dcterms:source
 * dcterms:publisher
 * dcterms:isPartOf
 *
 * Variables available:
 *   $resource : the Omeka S resource
 *   $block    : the block object
 *   $heading  : optional heading text
 */
$plugins = $this->getHelperPluginManager();
$isHtml = $plugins->get('isHtml');
$escape = $plugins->get('escapeHtml');
$siteSetting = $plugins->get('siteSetting');

$filterLocale = (bool) $siteSetting('filter_locale_values');
$lang = $this->lang();
$langValue = $filterLocale ? [$lang, ''] : null;

$fields = [
    'dcterms:creator'     => $this->translate('Creator'),
    'dcterms:audience'    => $this->translate('Audience'),
    'dcterms:date'        => $this->translate('Date'),
    'dcterms:coverage'    => $this->translate('Coverage'),
    'foaf:based_near'     => $this->translate('Based Near'),
    'dcterms:description' => $this->translate('Description'),
    'dcterms:type'        => $this->translate('Type'),
    'dcterms:format'      => $this->translate('Format'),
    'dcterms:language'    => $this->translate('Language'),
    'dcterms:source'      => $this->translate('Source'),
    'dcterms:publisher'   => $this->translate('Publisher'),
    'dcterms:isPartOf'    => $this->translate('Is Part Of'),
];
?>

<div class="block block-resource block-core-values">

    <?php if (!empty($heading)): ?>
        <h3><?php echo $heading; ?></h3>
    <?php endif; ?>

    <div class="block-content">

        <?php foreach ($fields as $term => $label): ?>
            <?php if ($values = $resource->value($term, ['all' => true, 'lang' => $langValue])): ?>
                <?php foreach ($values as $value): ?>
                    <p>
                        <strong><?php echo $label; ?>:</strong>
                        <?php echo $isHtml($value) ? $value : $escape($value); ?>
                    </p>
                <?php endforeach; ?>
            <?php endif; ?>
        <?php endforeach; ?>

    </div>

</div>
